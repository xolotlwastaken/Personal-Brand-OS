# Copy to .env; bootstrap defaults these to the invoking host user's IDs.
HERMES_UID=1000
HERMES_GID=1000
HERMES_IMAGE=nousresearch/hermes-agent@sha256:9774f4f39a9bb8c2f68ce728ed5e99ddbad282163be56764afacf88ed952b784
# Initially uses the existing NVIDIA provider if securely provisioned.
BRAND_MODEL=nvidia/nemotron-3-ultra-550b-a55b
BRAND_PROVIDER=nvidia
BRAND_BASE_URL=https://integrate.api.nvidia.com/v1
# Model credentials belong in data/hermes/profiles/<profile>/.env, NOT here.
# No social account credentials are needed or supported.
